{
    "name": "nativephp/web-ui",
    "description": "EDGE web render target for NativePHP — the same screens as HTML in a browser",
    "keywords": [
        "nativephp",
        "laravel",
        "edge",
        "mobile",
        "web",
        "ssr"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "NativePHP",
            "email": "support@nativephp.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.4"
    },
    "autoload": {
        "psr-4": {
            "Native\\Mobile\\Edge\\Web\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Native\\Mobile\\Edge\\Web\\WebServiceProvider"
            ]
        }
    },
    "require-dev": {
        "laravel/pint": "^1.24"
    },
    "scripts": {
        "lint": "pint",
        "lint:test": "pint --test"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://nativephp.com/sponsor"
        }
    ]
}
